CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_QMSD_BOARD_CUSTOM=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_QMSD_BOARD_BACKLIGHT_VALUE=100
CONFIG_QMSD_BOARD_TOUCH_EN=y
CONFIG_QMSD_TOUCH_I2C_FREQ=400000
CONFIG_QMSD_BOARD_GUI_EN=y
CONFIG_QMSD_GUI_DOUBLE_BUFFER=y
CONFIG_QMSD_GUI_BUFFER_IN_PSRAM=y
CONFIG_QMSD_GUI_LVGL_V8=y
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_COLOR_DEPTH=16
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEM_CUSTOM_INCLUDE="stdlib.h"
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_USE_QRCODE=y
CONFIG_LV_DPI_DEF=130
CONFIG_HTTPD_WS_SUPPORT=y
# Touch calibration (same physical panel as esp-resto, portrait 320x480)
CONFIG_VKEY_TOUCH_X_MIN=4
CONFIG_VKEY_TOUCH_X_MAX=307
CONFIG_VKEY_TOUCH_Y_MIN=4
CONFIG_VKEY_TOUCH_Y_MAX=475
# WiFi credentials for station mode. Empty password support not needed; set your router SSID/pass.
CONFIG_VKEY_WIFI_SSID=""
CONFIG_VKEY_WIFI_PASSWORD=""
CONFIG_VKEY_AP_FALLBACK_TIMEOUT_MS=15000
